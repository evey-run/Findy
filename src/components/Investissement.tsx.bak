import React, { useState, useEffect, useMemo } from 'react';
import { useAppStore } from '../store';
import { useLocation, useNavigate } from 'react-router-dom';
import Papa from 'papaparse';

// Styles pour les cellules éditables sont intégrés directement dans les classes CSS

// Styles pour la barre de scroll personnalisée
const scrollbarStyles = `
  /* Webkit browsers (Chrome, Safari, Edge) */
  ::-webkit-scrollbar {
    width: 12px;
  }
  
  ::-webkit-scrollbar-track {
    background: #1f2226;
    border-radius: 8px;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #272a2f;
    border-radius: 8px;
    border: 1px solid #1f2226;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #6227f5;
    border: 1px solid #1f2226;
  }
  
  ::-webkit-scrollbar-thumb:active {
    background: #6227f5;
    border: 1px solid #1f2226;
  }
  
  /* Firefox */
  html {
    scrollbar-width: auto;
    scrollbar-color: #272a2f #1f2226;
  }
  
  /* Styles spécifiques pour les conteneurs avec scroll */
  .custom-scrollbar::-webkit-scrollbar {
    width: 12px;
  }
  
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #1f2226;
    border-radius: 8px;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #272a2f !important;
    border-radius: 8px;
    border: 1px solid #1f2226;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #6227f5 !important;
    border: 1px solid #1f2226;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb:active {
    background: #6227f5 !important;
    border: 1px solid #1f2226;
  }
  
  /* Force pour tous les scrollbars */
  * {
    scrollbar-width: auto;
    scrollbar-color: #272a2f #1f2226;
  }
  
  /* Couleur des séparateurs de lignes */
  .divide-y > * + * {
    border-top-color: #1f2226 !important;
  }
  
  .divide-gray-600 > * + * {
    border-top-color: #1f2226 !important;
  }
`;

// Injecter les styles dans le document
if (typeof document !== 'undefined') {
  const styleElement = document.createElement('style');
  styleElement.textContent = scrollbarStyles;
  if (!document.head.querySelector('style[data-scrollbar-custom]')) {
    styleElement.setAttribute('data-scrollbar-custom', 'true');
    document.head.appendChild(styleElement);
  }
}

interface EditingTransaction {
  id: string;
  amount: number;
  description: string;
  date: string;
  checked: boolean;
  unitPrice?: number;
  quantity?: number;
  bankId?: string;
}

interface InlineEditCell {
  transactionId: string;
  field: 'amount' | 'description' | 'date' | 'bank' | 'checked' | 'unitPrice' | 'quantity';
}

// Fonction de formatage du montant
const formatAmount = (amount: number) => {
  return new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: 'EUR'
  }).format(amount);
};

// Fonction de formatage de la date
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('fr-FR');
};

// Fonction pour traiter une ligne au format Binance
const processBinanceRow = (row: any, bankId: string, importErrors: string[], rowIndex: number): any => {
  try {
    console.log('Traitement ligne CSV format Binance:', row);
    
    // Vérifier que bankId est valide
    if (!bankId) {
      importErrors.push(`Ligne ${rowIndex + 2}: Compte d'investissement non spécifié`);
      return null;
    }
    
    // Extraire les données nécessaires avec gestion des différentes variantes de noms de colonnes
    const dateValue = row['date(utc)'] || row['dateutc'] || row['date'] || row['utcdate'] || row['time'] || row['timestamp'];
    const orderNo = row['orderno'] || row['order_no'] || row['orderid'] || row['order_id'] || row['id'] || row['transaction_id'];
    const pair = row['pair'] || row['symbol'] || row['market'] || row['coin'] || row['asset'];
    const type = row['type'] || row['ordertype'] || row['order_type'] || row['operation'] || row['operation_type'];
    const side = row['side'] || row['direction'] || row['tradeside'] || row['trade_side'] || row['operation'];
    
    // Recherche plus approfondie pour le montant
    let amountValue;
    const possibleAmountFields = ['tradingtotal', 'trading_total', 'total', 'amount', 'value', 'eur', 'usd', 'fiat_amount', 'fiat', 'cost', 'total_cost'];
    
    for (const field of possibleAmountFields) {
      // Vérifier les variantes de casse (majuscules, minuscules, camelCase)
      const variants = [field, field.toLowerCase(), field.toUpperCase(), field.charAt(0).toUpperCase() + field.slice(1)];
      
      for (const variant of variants) {
        if (row[variant] !== undefined && row[variant] !== '') {
          amountValue = row[variant];
          break;
        }
      }
      
      if (amountValue !== undefined) break;
    }
    
    // Si toujours pas de montant, essayer de le calculer à partir du prix et de la quantité
    if ((!amountValue && amountValue !== 0) || amountValue === '') {
      const priceValue = row['averageprice'] || row['average_price'] || row['price'] || row['unitprice'] || row['unit_price'] || row['price_eur'] || row['price_usd'];
      const quantityValue = row['executed'] || row['quantity'] || row['qty'] || row['size'] || row['volume'] || row['amount'];
      
      if (priceValue && quantityValue) {
        try {
          const price = parseFloat(String(priceValue).replace(/[^0-9.-]/g, '').replace(',', '.'));
          const qty = parseFloat(String(quantityValue).replace(/[^0-9.-]/g, '').replace(',', '.'));
          amountValue = price * qty;
          console.log(`Calculated amount from price (${price}) * quantity (${qty}) = ${amountValue}`);
        } catch (e) {
          console.warn('Failed to calculate amount from price and quantity:', e);
        }
      }
    }
    
    // Parser la date (format Binance: YYYY-MM-DD HH:MM:SS)
    let parsedDate: Date;
    try {
      if (dateValue) {
        parsedDate = new Date(dateValue);
        if (isNaN(parsedDate.getTime())) {
          // Essayer d'autres formats de date
          const formats = [
            // Format timestamp (millisecondes)
            (val: string) => new Date(parseInt(val)),
            // Format DD/MM/YYYY
            (val: string) => {
              const parts = val.split('/');
              return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
            },
            // Format MM/DD/YYYY
            (val: string) => {
              const parts = val.split('/');
              return new Date(parseInt(parts[2]), parseInt(parts[0]) - 1, parseInt(parts[1]));
            }
          ];
          
          for (const format of formats) {
            try {
              parsedDate = format(dateValue);
              if (!isNaN(parsedDate.getTime())) break;
            } catch (e) {
              console.warn('Failed to parse date with format:', e);
            }
          }
        }
      }
    } catch (e) {
      console.warn('Failed to parse date:', e);
    }
    
    if (!parsedDate || isNaN(parsedDate.getTime())) {
      importErrors.push(`Ligne ${rowIndex + 2}: Date invalide ou manquante`);
      parsedDate = new Date(); // Utiliser la date actuelle comme fallback
    }
    
    // Construire la description
    let description = '';
    if (type && side) {
      description = `${type} ${side} ${pair || ''}`;
    } else if (type) {
      description = `${type} ${pair || ''}`;
    } else if (side) {
      description = `${side} ${pair || ''}`;
    } else if (pair) {
      description = `Transaction ${pair}`;
    } else if (orderNo) {
      description = `Order #${orderNo}`;
    } else {
      description = "Transaction Binance";
    }
    
    // Nettoyer et convertir le montant
    let amount = 0;
    if (amountValue !== undefined) {
      try {
        // Convertir en nombre
        if (typeof amountValue === 'string') {
          amount = parseFloat(amountValue.replace(/[^0-9.-]/g, '').replace(',', '.'));
        } else {
          amount = parseFloat(amountValue);
        }
        
        // Vérifier si c'est un nombre valide
        if (isNaN(amount)) {
          importErrors.push(`Ligne ${rowIndex + 2}: Montant invalide`);
          amount = 0;
        }
      } catch (e) {
        importErrors.push(`Ligne ${rowIndex + 2}: Erreur lors de la conversion du montant`);
        amount = 0;
      }
    } else {
      importErrors.push(`Ligne ${rowIndex + 2}: Montant manquant`);
    }
    
    // Extraire le prix unitaire et la quantité si disponibles
    let unitPrice = null;
    let quantity = null;
    
    const priceValue = row['averageprice'] || row['average_price'] || row['price'] || row['unitprice'] || row['unit_price'] || row['price_eur'] || row['price_usd'];
    const quantityValue = row['executed'] || row['quantity'] || row['qty'] || row['size'] || row['volume'] || row['amount'];
    
    if (priceValue) {
      try {
        unitPrice = parseFloat(String(priceValue).replace(/[^0-9.-]/g, '').replace(',', '.'));
      } catch (e) {
        console.warn('Failed to parse unit price:', e);
      }
    }
    
    if (quantityValue) {
      try {
        quantity = parseFloat(String(quantityValue).replace(/[^0-9.-]/g, '').replace(',', '.'));
      } catch (e) {
        console.warn('Failed to parse quantity:', e);
      }
    }
    
    // Créer la transaction
    return {
      date: parsedDate.toISOString(),
      amount: amount,
      description: description,
      checked: false,
      bankId: bankId,
      unitPrice: unitPrice,
      quantity: quantity
    };
  } catch (error) {
    console.error('Erreur lors du traitement de la ligne Binance:', error);
    importErrors.push(`Ligne ${rowIndex + 2}: Erreur de traitement - ${error.message || 'Erreur inconnue'}`);
    
    // Créer une transaction par défaut pour éviter les erreurs
    return {
      date: new Date().toISOString(),
      amount: 0,
      description: `Transaction Binance (erreur de traitement)`,
      checked: false,
      bankId: bankId
    };
  }
};

export default function Investissement() {
  const { 
    transactions, 
    banks, 
    loadTransactions, 
    loadBanks,
    updateTransaction,
    removeTransaction,
    addTransaction,
    loadMoreTransactions,
    appendTransactions
  } = useAppStore();
  
  // État local pour la banque sélectionnée (au lieu d'utiliser l'état global)
  const [localSelectedBank, setLocalSelectedBank] = useState<any>(null);
  
  // États pour l'import CSV
  const [showImportModal, setShowImportModal] = useState(false);
  const [csvFile, setCsvFile] = useState<File | null>(null);
  const [importBankId, setImportBankId] = useState<string>(''); // État séparé pour la banque dans le modal d'import CSV
  const [importProgress, setImportProgress] = useState<{
    isImporting: boolean;
    imported: number;
    total: number;
    errors: string[];
  }>({
    isImporting: false,
    imported: 0,
    total: 0,
    errors: []
  });

  // États pour le scroll infini
  const [page, setPage] = useState(1);
  const [hasMore, setHasMore] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const ITEMS_PER_PAGE = 50;
  
  // États pour la sélection multiple
  const [selectedTransactions, setSelectedTransactions] = useState<string[]>([]);
  const [selectAll, setSelectAll] = useState(false);
  const [isDeleting, setIsDeleting] = useState(false);
  const [deleteProgress, setDeleteProgress] = useState<{
    total: number;
    processed: number;
    success: number;
    errors: number;
  }>({ total: 0, processed: 0, success: 0, errors: 0 });
  
  const [loading, setLoading] = useState(true);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [editingTransaction, setEditingTransaction] = useState<EditingTransaction | null>(null);
  
  // Inline editing states
  const [inlineEditCell, setInlineEditCell] = useState<InlineEditCell | null>(null);
  const [inlineEditValue, setInlineEditValue] = useState<string>('');
  
  const [filters, setFilters] = useState({
    checked: '',
    startDate: '',
    endDate: '',
    searchText: ''
  });

  // État local pour la saisie du texte de recherche
  const [searchInput, setSearchInput] = useState('');
  
  // Récupérer les paramètres d'URL
  const location = useLocation();
  const navigate = useNavigate();

  // Nous n'avons plus besoin de filtrer les transactions côté client
  // car nous les chargeons déjà filtrées par type de compte
  const investmentTransactions = transactions;
  
  // États pour l'édition en masse
  const [bulkEditFilters, setBulkEditFilters] = useState({
    startDate: '',
    endDate: '',
    searchText: '',
    checked: ''
  });
  
  const [bulkEditActions, setBulkEditActions] = useState({
    description: '',
    checked: false
  });
  
  const [bulkEditTransactions, setBulkEditTransactions] = useState<any[]>([]);
  
  // Filtrer les transactions selon les critères
  const filteredTransactions = useMemo(() => {
    return investmentTransactions.filter(transaction => {
      // Filtre par statut (vérifié/non vérifié)
      if (filters.checked === 'checked' && !transaction.checked) return false;
      if (filters.checked === 'unchecked' && transaction.checked) return false;
      
      // Filtre par date
      if (filters.startDate && new Date(transaction.date) < new Date(filters.startDate)) return false;
      if (filters.endDate && new Date(transaction.date) > new Date(filters.endDate)) return false;
      
      // Filtre par texte de recherche
      if (filters.searchText) {
        const searchLower = filters.searchText.toLowerCase();
        const descriptionMatch = transaction.description?.toLowerCase().includes(searchLower);
        const amountMatch = transaction.amount?.toString().includes(searchLower);
        const dateMatch = new Date(transaction.date).toLocaleDateString('fr-FR').includes(searchLower);
        
        if (!descriptionMatch && !amountMatch && !dateMatch) return false;
      }
      
      return true;
    });
  }, [investmentTransactions, filters]);
  
  // Fonction pour ajouter une transaction
  const handleAddTransaction = async () => {
    if (!localSelectedBank) {
      alert('Veuillez sélectionner un compte d\'investissement');
      return;
    }
    
    const newTransaction = {
      date: new Date().toISOString(),
      amount: 0,
      description: 'Nouvelle transaction',
      checked: false,
      bankId: localSelectedBank.id
    };
    
    try {
      await addTransaction(newTransaction);
    } catch (error) {
      console.error('Erreur lors de l\'ajout de la transaction:', error);
      alert(`Erreur lors de l'ajout de la transaction: ${error.message || 'Erreur inconnue'}`);
    }
  };
  
  // Fonction pour supprimer une transaction
  const handleDeleteTransaction = async (id: string) => {
    if (window.confirm('Êtes-vous sûr de vouloir supprimer cette transaction ?')) {
      try {
        await removeTransaction(id);
      } catch (error) {
        console.error('Erreur lors de la suppression de la transaction:', error);
        alert(`Erreur lors de la suppression: ${error.message || 'Erreur inconnue'}`);
      }
    }
  };
  
  // Fonction pour gérer la sélection/désélection d'une transaction
  const handleToggleSelect = (transactionId: string) => {
    setSelectedTransactions(prev => {
      if (prev.includes(transactionId)) {
        return prev.filter(id => id !== transactionId);
      } else {
        return [...prev, transactionId];
      }
    });
    
    // Si on désélectionne une transaction, on désactive aussi le selectAll
    if (selectAll) {
      setSelectAll(false);
    }
  };
  
  // Fonction pour gérer la sélection/désélection de toutes les transactions
  const handleToggleSelectAll = () => {
    if (selectAll) {
      // Désélectionner tout
      setSelectedTransactions([]);
      setSelectAll(false);
    } else {
      // Sélectionner toutes les transactions filtrées
      const allIds = filteredTransactions.map(transaction => transaction.id);
      setSelectedTransactions(allIds);
      setSelectAll(true);
    }
  };
  
  // Fonction pour supprimer les transactions sélectionnées
  const handleDeleteSelected = async () => {
    if (selectedTransactions.length === 0) return;
    
    const confirmMessage = selectedTransactions.length === 1
      ? 'Êtes-vous sûr de vouloir supprimer cette transaction ?'
      : `Êtes-vous sûr de vouloir supprimer ces ${selectedTransactions.length} transactions ?`;
    
    if (window.confirm(confirmMessage)) {
      setIsDeleting(true);
      setDeleteProgress({
        total: selectedTransactions.length,
        processed: 0,
        success: 0,
        errors: 0
      });
      
      // Supprimer les transactions une par une
      for (const id of selectedTransactions) {
        try {
          await removeTransaction(id);
          setDeleteProgress(prev => ({
            ...prev,
            processed: prev.processed + 1,
            success: prev.success + 1
          }));
        } catch (error) {
          console.error(`Erreur lors de la suppression de la transaction ${id}:`, error);
          setDeleteProgress(prev => ({
            ...prev,
            processed: prev.processed + 1,
            errors: prev.errors + 1
          }));
        }
      }
      
      // Réinitialiser les états après la suppression
      setSelectedTransactions([]);
      setSelectAll(false);
      setIsDeleting(false);
      
      // Afficher un message de confirmation
      const { success, errors } = deleteProgress;
      if (errors === 0) {
        alert(`${success} transaction(s) supprimée(s) avec succès.`);
      } else {
        alert(`${success} transaction(s) supprimée(s) avec succès. ${errors} erreur(s) rencontrée(s).`);
      }
    }
  };
  
  // Fonction pour mettre à jour une transaction
  const handleUpdateTransaction = async (id: string, data: any) => {
    try {
      await updateTransaction(id, data);
      setEditingId(null);
      setEditingTransaction(null);
    } catch (error) {
      console.error('Erreur lors de la mise à jour de la transaction:', error);
      alert(`Erreur lors de la mise à jour: ${error.message || 'Erreur inconnue'}`);
    }
  };
  
  // Fonction pour gérer l'édition d'une transaction
  const handleEditTransaction = (transaction: any) => {
    setEditingId(transaction.id);
    setEditingTransaction({
      id: transaction.id,
      amount: transaction.amount,
      description: transaction.description,
      date: transaction.date,
      checked: transaction.checked,
      unitPrice: transaction.unitPrice,
      quantity: transaction.quantity,
      bankId: transaction.bankId
    });
  };
  
  // Fonction pour annuler l'édition
  const handleCancelEdit = () => {
    setEditingId(null);
    setEditingTransaction(null);
  };
  
  // Fonction pour gérer le changement de statut (vérifié/non vérifié)
  const handleToggleChecked = async (id: string, currentChecked: boolean) => {
    try {
      await updateTransaction(id, { checked: !currentChecked });
    } catch (error) {
      console.error('Erreur lors de la mise à jour du statut:', error);
      alert(`Erreur lors de la mise à jour du statut: ${error.message || 'Erreur inconnue'}`);
    }
  };
  
  // Fonction pour gérer l'édition inline d'une cellule
  const handleInlineEdit = (transactionId: string, field: 'amount' | 'description' | 'date' | 'bank' | 'checked' | 'unitPrice' | 'quantity') => {
    const transaction = investmentTransactions.find(t => t.id === transactionId);
    if (!transaction) return;
    
    let initialValue = '';
    
    switch (field) {
      case 'amount':
        initialValue = transaction.amount.toString();
        break;
      case 'description':
        initialValue = transaction.description || '';
        break;
      case 'date':
        initialValue = transaction.date ? new Date(transaction.date).toISOString().split('T')[0] : '';
        break;
      case 'bank':
        initialValue = transaction.bankId || '';
        break;
      case 'checked':
        initialValue = transaction.checked ? 'true' : 'false';
        break;
      case 'unitPrice':
        initialValue = transaction.unitPrice ? transaction.unitPrice.toString() : '';
        break;
      case 'quantity':
        initialValue = transaction.quantity ? transaction.quantity.toString() : '';
        break;
    }
    
    setInlineEditCell({ transactionId, field });
    setInlineEditValue(initialValue);
  };
  
  // Fonction pour sauvegarder l'édition inline
  const handleSaveInlineEdit = async () => {
    if (!inlineEditCell) return;
    
    const { transactionId, field } = inlineEditCell;
    let value: any = inlineEditValue;
    
    // Convertir la valeur selon le type de champ
    switch (field) {
      case 'amount':
      case 'unitPrice':
      case 'quantity':
        value = parseFloat(value);
        if (isNaN(value)) {
          alert('Veuillez entrer un nombre valide');
          return;
        }
        break;
      case 'checked':
        value = value === 'true';
        break;
    }
    
    try {
      await updateTransaction(transactionId, { [field]: value });
      setInlineEditCell(null);
      setInlineEditValue('');
    } catch (error) {
      console.error(`Erreur lors de la mise à jour du champ ${field}:`, error);
      alert(`Erreur lors de la mise à jour: ${error.message || 'Erreur inconnue'}`);
    }
  };
  
  // Fonction pour annuler l'édition inline
  const handleCancelInlineEdit = () => {
    setInlineEditCell(null);
    setInlineEditValue('');
  };
  
  // Fonction pour gérer l'import CSV
  const handleImportCSV = async () => {
    if (!csvFile || !importBankId) {
      alert('Veuillez sélectionner un fichier CSV et un compte d\'investissement');
      return;
    }
    
    setImportProgress({
      isImporting: true,
      imported: 0,
      total: 0,
      errors: []
    });
    
    // Lire le fichier CSV avec PapaParse
    Papa.parse(csvFile, {
      header: true,
      skipEmptyLines: true,
      complete: async (results) => {
        const { data, errors } = results;
        const importErrors: string[] = [];
        
        if (errors.length > 0) {
          setImportProgress(prev => ({
            ...prev,
            isImporting: false,
            errors: [...prev.errors, ...errors.map(e => `Erreur de parsing: ${e.message} à la ligne ${e.row}`)]
          }));
          return;
        }
        
        setImportProgress(prev => ({
          ...prev,
          total: data.length
        }));
        
        // Détecter le format du CSV
        const isBinanceFormat = Object.keys(data[0] || {}).some(key => 
          key.toLowerCase().includes('binance') || 
          key.toLowerCase().includes('coin') || 
          key.toLowerCase().includes('crypto') ||
          key.toLowerCase().includes('pair') ||
          key.toLowerCase().includes('symbol')
        );
        
        // Traiter chaque ligne du CSV
        for (let i = 0; i < data.length; i++) {
          const row = data[i];
          let transaction;
          
          if (isBinanceFormat) {
            transaction = processBinanceRow(row, importBankId, importErrors, i);
          } else {
            // Format standard
            transaction = {
              date: row.date ? new Date(row.date).toISOString() : new Date().toISOString(),
              amount: parseFloat(row.amount || '0'),
              description: row.description || 'Transaction importée',
              checked: row.checked === 'true' || row.checked === '1',
              bankId: importBankId,
              unitPrice: row.unitPrice ? parseFloat(row.unitPrice) : null,
              quantity: row.quantity ? parseFloat(row.quantity) : null
            };
          }
          
          if (transaction) {
            try {
              await addTransaction(transaction);
              setImportProgress(prev => ({
                ...prev,
                imported: prev.imported + 1
              }));
            } catch (error) {
              console.error('Erreur lors de l\'ajout de la transaction:', error);
              importErrors.push(`Ligne ${i + 2}: ${error.message || 'Erreur inconnue'}`);
            }
          }
        }
        
        setImportProgress(prev => ({
          ...prev,
          isImporting: false,
          errors: [...prev.errors, ...importErrors]
        }));
        
        setCsvFile(null);
        setShowImportModal(false);
        
        // Afficher un message de confirmation
        const { imported, total, errors } = importProgress;
        if (errors.length === 0) {
          alert(`${imported} transaction(s) importée(s) avec succès.`);
        } else {
          alert(`${imported} transaction(s) importée(s) sur ${total}. ${errors.length} erreur(s) rencontrée(s).`);
        }
      },
      error: (error) => {
        console.error('Erreur lors du parsing du fichier CSV:', error);
        setImportProgress(prev => ({
          ...prev,
          isImporting: false,
          errors: [...prev.errors, `Erreur de parsing: ${error.message || 'Erreur inconnue'}`]
        }));
      }
    });
  };
  
  // Charger les transactions et les banques au chargement du composant
  useEffect(() => {
    const fetchData = async () => {
      setLoading(true);
      try {
        await loadBanks();
        await loadTransactions('investment');
      } catch (error) {
        console.error('Erreur lors du chargement des données:', error);
      } finally {
        setLoading(false);
      }
    };
    
    fetchData();
  }, [loadBanks, loadTransactions]);
  
  // Mettre à jour la banque sélectionnée lorsque les banques sont chargées
  useEffect(() => {
    if (banks.length > 0 && !localSelectedBank) {
      // Trouver les banques de type 'investment'
      const investmentBanks = banks.filter(bank => bank.type === 'investment');
      if (investmentBanks.length > 0) {
        setLocalSelectedBank(investmentBanks[0]);
      }
    }
  }, [banks, localSelectedBank]);
  
  // Fonction pour formater le montant avec la devise
  const formatCurrency = (amount: number) => {
    return new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: 'EUR'
    }).format(amount);
  };
  
  // Fonction pour rendre les avatars des utilisateurs
  const renderUserAvatars = (users: any[]) => {
    if (!users || users.length === 0) return null;
    
    return (
      <div className="flex -space-x-2 overflow-hidden">
        {users.map((user, index) => (
          <img
            key={index}
            className="inline-block h-6 w-6 rounded-full ring-2 ring-white"
            src={user.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=random`}
            alt={user.name}
            title={user.name}
          />
        ))}
      </div>
    );
  };
  
  // Fonction pour gérer le changement de filtre
  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };
  
  // Fonction pour réinitialiser les filtres
  const handleResetFilters = () => {
    setFilters({
      checked: '',
      startDate: '',
      endDate: '',
      searchText: ''
    });
    setSearchInput('');
  };
  
  // Fonction pour appliquer le filtre de recherche
  const handleSearch = () => {
    setFilters(prev => ({ ...prev, searchText: searchInput }));
  };
  
  // Fonction pour gérer la touche Entrée dans le champ de recherche
  const handleSearchKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') {
      handleSearch();
    }
  };
  
  // Calculer le total des transactions filtrées
  const totalAmount = useMemo(() => {
    return filteredTransactions.reduce((sum, transaction) => sum + transaction.amount, 0);
  }, [filteredTransactions]);
  
  // Calculer le total des transactions sélectionnées
  const selectedTotalAmount = useMemo(() => {
    return filteredTransactions
      .filter(transaction => selectedTransactions.includes(transaction.id))
      .reduce((sum, transaction) => sum + transaction.amount, 0);
  }, [filteredTransactions, selectedTransactions]);
  
  // Fonction pour gérer le changement de banque sélectionnée
  const handleBankChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {
    const bankId = e.target.value;
    const selectedBank = banks.find(bank => bank.id === bankId);
    setLocalSelectedBank(selectedBank || null);
    
    // Recharger les transactions pour cette banque
    try {
      await loadTransactions('investment', bankId);
    } catch (error) {
      console.error('Erreur lors du chargement des transactions:', error);
    }
  };
  
  // Filtrer les banques pour n'afficher que celles de type 'investment'
  const investmentBanks = banks.filter(bank => bank.accountType === 'INVESTMENT');
  
  // Rendu du composant
  return (
    <div className="p-4 bg-gray-900 text-white min-h-screen">
      <h1 className="text-2xl font-bold mb-4">Investissements</h1>
      
      {/* Sélection du compte d'investissement */}
      <div className="mb-4">
        <label htmlFor="bankSelect" className="block text-sm font-medium text-gray-300 mb-1">
          Compte d'investissement
        </label>
        <select
          id="bankSelect"
          className="bg-gray-800 text-white border border-gray-700 rounded-md p-2 w-full"
          value={localSelectedBank?.id || ''}
          onChange={handleBankChange}
        >
          <option value="">Sélectionner un compte</option>
          {investmentBanks.map(bank => (
            <option key={bank.id} value={bank.id}>
              {bank.name}
            </option>
          ))}
        </select>
      </div>
      
      {/* Filtres */}
      <div className="mb-4 bg-gray-800 p-4 rounded-md">
        <h2 className="text-lg font-semibold mb-2">Filtres</h2>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label htmlFor="searchInput" className="block text-sm font-medium text-gray-300 mb-1">
              Recherche
            </label>
            <div className="flex">
              <input
                id="searchInput"
                type="text"
                className="bg-gray-700 text-white border border-gray-600 rounded-l-md p-2 flex-grow"
                placeholder="Rechercher..."
                value={searchInput}
                onChange={(e) => setSearchInput(e.target.value)}
                onKeyDown={handleSearchKeyDown}
              />
              <button
                className="bg-purple-600 hover:bg-purple-700 text-white px-4 rounded-r-md"
                onClick={handleSearch}
              >
                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </button>
            </div>
          </div>
          
          <div>
            <label htmlFor="startDate" className="block text-sm font-medium text-gray-300 mb-1">
              Date début
            </label>
            <input
              id="startDate"
              type="date"
              className="bg-gray-700 text-white border border-gray-600 rounded-md p-2 w-full"
              name="startDate"
              value={filters.startDate}
              onChange={handleFilterChange}
            />
          </div>
          
          <div>
            <label htmlFor="endDate" className="block text-sm font-medium text-gray-300 mb-1">
              Date fin
            </label>
            <input
              id="endDate"
              type="date"
              className="bg-gray-700 text-white border border-gray-600 rounded-md p-2 w-full"
              name="endDate"
              value={filters.endDate}
              onChange={handleFilterChange}
            />
          </div>
          
          <div>
            <label htmlFor="checkedFilter" className="block text-sm font-medium text-gray-300 mb-1">
              Statut
            </label>
            <select
              id="checkedFilter"
              className="bg-gray-700 text-white border border-gray-600 rounded-md p-2 w-full"
              name="checked"
              value={filters.checked}
              onChange={handleFilterChange}
            >
              <option value="">Tous</option>
              <option value="checked">Vérifiés</option>
              <option value="unchecked">Non vérifiés</option>
            </select>
          </div>
        </div>
        
        <div className="mt-2 flex justify-end">
          <button
            className="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-md mr-2"
            onClick={handleResetFilters}
          >
            Réinitialiser
          </button>
        </div>
      </div>
      
      {/* Actions */}
      <div className="mb-4 flex justify-between items-center">
        <div className="flex space-x-2">
          <button
            className="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md flex items-center"
            onClick={handleAddTransaction}
          >
            <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Ajouter
          </button>
          
          <button
            className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md flex items-center"
            onClick={() => setShowImportModal(true)}
          >
            <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
            </svg>
            Importer CSV
          </button>
          
          {/* Bouton de suppression multiple - visible uniquement si des transactions sont sélectionnées */}
          {selectedTransactions.length > 0 && (
            <button
              className="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md flex items-center"
              onClick={handleDeleteSelected}
              disabled={isDeleting}
            >
              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              {isDeleting ? 'Suppression...' : `Supprimer (${selectedTransactions.length})`}
            </button>
          )}
        </div>
        
        <div className="text-gray-300">
          {filteredTransactions.length} transaction(s) - Total: {formatCurrency(totalAmount)}
          {selectedTransactions.length > 0 && (
            <span className="ml-2 text-purple-400">
              Sélection: {selectedTransactions.length} - {formatCurrency(selectedTotalAmount)}
            </span>
          )}
        </div>
      </div>
      
      {/* Barre de progression de suppression */}
      {isDeleting && (
        <div className="mb-4">
          <div className="w-full bg-gray-700 rounded-full h-2.5">
            <div 
              className="bg-purple-600 h-2.5 rounded-full" 
              style={{ width: `${(deleteProgress.processed / deleteProgress.total) * 100}%` }}
            ></div>
          </div>
          <div className="text-sm text-gray-400 mt-1">
            Suppression en cours: {deleteProgress.processed}/{deleteProgress.total} 
            ({deleteProgress.success} réussies, {deleteProgress.errors} erreurs)
          </div>
        </div>
      )}
      
      {/* Tableau des transactions */}
      <div className="overflow-x-auto bg-gray-800 rounded-md">
        <table className="min-w-full divide-y divide-gray-700">
          <thead className="bg-gray-700">
            <tr>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider w-10">
                <div className="flex items-center">
                  <input
                    type="checkbox"
                    className="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-600 rounded"
                    checked={selectAll}
                    onChange={handleToggleSelectAll}
                  />
                </div>
              </th>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                Date
              </th>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                Description
              </th>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                Montant
              </th>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                Vérifié
              </th>
              <th scope="col" className="px-3 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody className="bg-gray-800 divide-y divide-gray-700">
            {loading ? (
              <tr>
                <td colSpan={6} className="px-3 py-4 text-center text-gray-400">
                  <div className="flex justify-center items-center space-x-2">
                    <svg className="animate-spin h-5 w-5 text-purple-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                      <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Chargement...</span>
                  </div>
                </td>
              </tr>
            ) : filteredTransactions.length === 0 ? (
              <tr>
                <td colSpan={6} className="px-3 py-4 text-center text-gray-400">
                  Aucune transaction trouvée
                </td>
              </tr>
            ) : (
              filteredTransactions.map(transaction => (
                <tr key={transaction.id} className={`hover:bg-gray-700 ${selectedTransactions.includes(transaction.id) ? 'bg-purple-900 bg-opacity-20' : ''}`}>
                  <td className="px-3 py-4 whitespace-nowrap">
                    <div className="flex items-center">
                      <input
                        type="checkbox"
                        className="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-600 rounded"
                        checked={selectedTransactions.includes(transaction.id)}
                        onChange={() => handleToggleSelect(transaction.id)}
                      />
                    </div>
                  </td>
                  <td className="px-3 py-4 whitespace-nowrap">
                    {editingId === transaction.id ? (
                      <input
                        type="date"
                        className="bg-gray-700 text-white border border-gray-600 rounded-md p-1 w-full"
                        value={editingTransaction?.date?.substring(0, 10) || ''}
                        onChange={(e) => handleInlineEdit('date', e.target.value)}
                      />
                    ) : (
                      <div className="text-sm text-gray-300">{new Date(transaction.date).toLocaleDateString()}</div>
                    )}
                  </td>
                  <td className="px-3 py-4">
                    {editingId === transaction.id ? (
                      <input
                        type="text"
                        className="bg-gray-700 text-white border border-gray-600 rounded-md p-1 w-full"
                        value={editingTransaction?.description || ''}
                        onChange={(e) => handleInlineEdit('description', e.target.value)}
                      />
                    ) : (
                      <div className="text-sm text-gray-300">{transaction.description}</div>
                    )}
                  </td>
                  <td className="px-3 py-4 whitespace-nowrap">
                    {editingId === transaction.id ? (
                      <input
                        type="number"
                        step="0.01"
                        className="bg-gray-700 text-white border border-gray-600 rounded-md p-1 w-full"
                        value={editingTransaction?.amount || 0}
                        onChange={(e) => handleInlineEdit('amount', parseFloat(e.target.value))}
                      />
                    ) : (
                      <div className={`text-sm ${transaction.amount >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                        {formatCurrency(transaction.amount)}
                      </div>
                    )}
                  </td>
                  <td className="px-3 py-4 whitespace-nowrap">
                    <div className="flex items-center">
                      <input
                        type="checkbox"
                        className="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-600 rounded"
                        checked={transaction.checked}
                        onChange={() => handleToggleChecked(transaction.id)}
                      />
                    </div>
                  </td>
                  <td className="px-3 py-4 whitespace-nowrap text-sm font-medium">
                    {editingId === transaction.id ? (
                      <div className="flex space-x-2">
                        <button
                          className="text-green-400 hover:text-green-300"
                          onClick={handleSaveInlineEdit}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                          </svg>
                        </button>
                        <button
                          className="text-red-400 hover:text-red-300"
                          onClick={handleCancelInlineEdit}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        </button>
                      </div>
                    ) : (
                      <div className="flex space-x-2">
                        <button
                          className="text-blue-400 hover:text-blue-300"
                          onClick={() => handleEditTransaction(transaction)}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>
                        <button
                          className="text-red-400 hover:text-red-300"
                          onClick={() => handleDeleteTransaction(transaction.id)}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
