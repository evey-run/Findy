{
  "name": "finance",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node scripts/generate-migrations-bundle.mjs && tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "test:server": "tsx --test \"server/src/**/*.test.ts\"",
    "start:server": "node server/dist/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --no-watch",
    "build:server": "bash scripts/build-server.sh",
    "build:mac": "bash scripts/build-mac.sh",
    "migrations:bundle": "node scripts/generate-migrations-bundle.mjs",
    "test": "tsx --test \"server/src/**/*.test.ts\" \"src/lib/**/*.test.ts\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@ngrok/ngrok": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/multer": "^2.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "glob": "^11.1.0",
    "lucide-react": "^0.525.0",
    "multer": "^2.5.0",
    "papaparse": "^5.7.1",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8"
  }
}
