# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Backend (Express / Prisma)
DATABASE_URL="file:./dev.db"
PORT=36321
FRONTEND_URL="http://localhost:51737"

# Frontend (Vite) — base des URLs API/assets en production.
# Laisser vide en dev : le proxy Vite gère /api et /uploads.
VITE_API_BASE=


# Enable Banking
# Application ID depuis le Control Panel Enable Banking
ENABLE_BANKING_APP_ID=a3e2ab30-8855-41bc-a955-9f04c17bb7de
# Clé privée RSA (contenu du fichier .pem, sur une seule ligne ou multiligne)
ENABLE_BANKING_RSA_KEY=
