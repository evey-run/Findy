generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

model CategoryKeyword {
  id         String   @id @default(cuid())
  value      String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, value])
  @@map("category_keywords")
}

datasource db {
  provider = "sqlite"
  // Doit venir de l'environnement : l'app packagée passe le chemin de sa propre
  // base (~/Library/Application Support/…), et la CI utilise /tmp/build.db.
  // Codé en dur, le binaire compilé pointait sur le dev.db du dépôt.
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  avatar    String?
  isMe      Boolean    @default(false)
  // Mot de passe optionnel : sert uniquement à protéger le profil à la connexion.
  // Null = profil ouvert, on entre d'un clic. Format: "scrypt:<salt hex>:<hash hex>".
  passwordHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  spaceMembers SpaceMember[]
  debtsFrom Debt[]     @relation("DebtsOwed")
  debtsTo   Debt[]     @relation("DebtsOwing")

  @@map("users")
}

// Dette « tricount » entre deux personnes.
// fromUser doit `amount` à toUser (fromUser = débiteur, toUser = créancier).
model Debt {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime @default(now())
  settled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fromUserId  String
  toUserId    String
  fromUser    User     @relation("DebtsOwed", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("DebtsOwing", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("debts")
}

// Un Espace est le seul primitif de partage de l'app : un périmètre de données
// avec des membres. « Ozan » (perso, 1 membre), « Famille » (partagé, 2 membres).
// Tout ce qui est scopable appartient à un espace ; partager = déplacer d'espace.
model Space {
  id         String        @id @default(cuid())
  name       String
  kind       String        @default("PERSONAL") // PERSONAL | SHARED
  color      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  members    SpaceMember[]
  banks      Bank[]
  objectives Objective[]
  budgets    Budget[]
  categories Category[]

  @@map("spaces")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_members")
}

model Bank {
  id           String        @id @default(cuid())
  name         String
  shortName    String?
  color        String        @default("#3b82f6")
  image        String?
  iban         String?
  balance      Float         @default(0)
  accountType  String        @default("CURRENT")
  archived     Boolean       @default(false)
  /// Compter ce compte dans le reste à vivre. `null` = déduit du type de compte
  /// (les comptes courants comptent, l'épargne et l'investissement non). Sert à
  /// exclure un livret que la banque déclare comme compte courant.
  spendable    Boolean?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Enable Banking integration
  ebAspspName    String?
  ebAspspCountry String?
  ebState        String?
  ebSessionId    String?
  ebAccountUid   String?
  ebStatus       String?
  ebLinkedAt     DateTime?
  ebExpiresAt    DateTime?
  ebLastSyncAt   DateTime?
  spaceId      String
  space        Space         @relation(fields: [spaceId], references: [id])
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]

  @@map("banks")
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         String
  color        String        @default("#6b7280")
  icon         String?
  // null = catalogue commun, visible par tous. Non-null = catégorie privée à un espace.
  spaceId      String?
  space        Space?        @relation(fields: [spaceId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]
  keywords     CategoryKeyword[]

  @@map("categories")
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String
  date        DateTime  @default(now())
  checked     Boolean   @default(false)
  unitPrice   Float?
  quantity    Float?
  ticker      String?
  assetType   String?
  externalId  String?   // For deduplication (e.g. GoCardless transaction ID)
  currency    String?   // ISO 4217 currency code (e.g. "EUR", "USD")
  balanceAfterTransaction Float? // Real account balance after this transaction (from EB API)
  status      String    @default("BOOK") // BOOK (comptabilisée) ou PENDING (en attente)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bankId      String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  bank        Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  period     String   @default("MONTHLY")
  startDate  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bankId     String?
  categoryId String
  spaceId    String?
  space      Space?   @relation(fields: [spaceId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  bank       Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Recurrence {
  id          String   @id @default(cuid())
  amount      Float
  frequency   String   @default("MONTHLY")
  nextDue     DateTime
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bankId      String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  bank        Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("recurrences")
}

model Objective {
  id           String    @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  deadline     DateTime?
  isCompleted  Boolean   @default(false)
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  spaceId      String?
  space        Space?    @relation(fields: [spaceId], references: [id])

  @@map("objectives")
}
