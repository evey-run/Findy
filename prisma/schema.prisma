generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(cuid())
  name      String
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userBanks UserBank[]

  @@map("users")
}

model Bank {
  id           String        @id @default(cuid())
  name         String
  shortName    String?
  color        String        @default("#3b82f6")
  image        String?
  iban         String?
  balance      Float         @default(0)
  accountType  String        @default("CURRENT")
  archived     Boolean       @default(false)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]
  userBanks    UserBank[]

  @@map("banks")
}

model UserBank {
  id     String @id @default(cuid())
  userId String
  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId])
  @@map("user_banks")
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         String
  color        String        @default("#6b7280")
  icon         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String
  date        DateTime  @default(now())
  checked     Boolean   @default(false)
  unitPrice   Float?    // Prix unitaire pour les investissements
  quantity    Float?    // Quantité pour les investissements
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bankId      String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  bank        Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  period     String   @default("MONTHLY")
  startDate  DateTime @default(now())
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bankId     String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  bank       Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Recurrence {
  id          String   @id @default(cuid())
  amount      Float
  frequency   String   @default("MONTHLY")
  nextDue     DateTime
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bankId      String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  bank        Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("recurrences")
}

model Objective {
  id           String    @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  deadline     DateTime?
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("objectives")
}
