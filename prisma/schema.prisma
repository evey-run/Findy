generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

model CategoryKeyword {
  id         String   @id @default(cuid())
  value      String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, value])
  @@map("category_keywords")
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(cuid())
  name      String
  avatar    String?
  isMe      Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userBanks UserBank[]
  debtsFrom Debt[]     @relation("DebtsOwed")
  debtsTo   Debt[]     @relation("DebtsOwing")

  @@map("users")
}

// Dette « tricount » entre deux personnes.
// fromUser doit `amount` à toUser (fromUser = débiteur, toUser = créancier).
model Debt {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime @default(now())
  settled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fromUserId  String
  toUserId    String
  fromUser    User     @relation("DebtsOwed", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("DebtsOwing", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("debts")
}

model Bank {
  id           String        @id @default(cuid())
  name         String
  shortName    String?
  color        String        @default("#3b82f6")
  image        String?
  iban         String?
  balance      Float         @default(0)
  accountType  String        @default("CURRENT")
  archived     Boolean       @default(false)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Enable Banking integration
  ebAspspName    String?
  ebAspspCountry String?
  ebState        String?
  ebSessionId    String?
  ebAccountUid   String?
  ebStatus       String?
  ebLinkedAt     DateTime?
  ebExpiresAt    DateTime?
  ebLastSyncAt   DateTime?
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]
  userBanks    UserBank[]

  @@map("banks")
}

model UserBank {
  id     String @id @default(cuid())
  userId String
  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId])
  @@map("user_banks")
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         String
  color        String        @default("#6b7280")
  icon         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  recurrences  Recurrence[]
  transactions Transaction[]
  keywords     CategoryKeyword[]

  @@map("categories")
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String
  date        DateTime  @default(now())
  checked     Boolean   @default(false)
  unitPrice   Float?
  quantity    Float?
  ticker      String?
  assetType   String?
  externalId  String?   // For deduplication (e.g. GoCardless transaction ID)
  currency    String?   // ISO 4217 currency code (e.g. "EUR", "USD")
  balanceAfterTransaction Float? // Real account balance after this transaction (from EB API)
  status      String    @default("BOOK") // BOOK (comptabilisée) ou PENDING (en attente)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bankId      String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  bank        Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  period     String   @default("MONTHLY")
  startDate  DateTime @default(now())
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bankId     String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  bank       Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Recurrence {
  id          String   @id @default(cuid())
  amount      Float
  frequency   String   @default("MONTHLY")
  nextDue     DateTime
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bankId      String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  bank        Bank?    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@map("recurrences")
}

model Objective {
  id           String    @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  deadline     DateTime?
  isCompleted  Boolean   @default(false)
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("objectives")
}
