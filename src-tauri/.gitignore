# Generated by Cargo
# will have compiled files and executables
/target/

# Schémas ACL régénérés à chaque build, un fichier par cible.
/gen/schemas/

# `gen/android` et `gen/apple` SONT versionnés : le manifeste Android y est
# édité à la main (trafic en clair vers le serveur local) et aucun hook Tauri ne
# permet de le regénérer. Les .gitignore fournis dans ces dossiers couvrent déjà
# le gros des artefacts ; voici ce qu'ils oublient.
/gen/android/build/
/gen/android/app/build/
/gen/android/.tauri/
/gen/apple/Pods/
/gen/apple/Podfile.lock
/gen/apple/.tauri/
/gen/apple/*.xcodeproj/project.xcworkspace/xcuserdata/
/gen/apple/*.xcworkspace/xcuserdata/
