{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Findy",
  "version": "0.4.3",
  "identifier": "com.evey.finance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:51737",
    "beforeDevCommand": "bash scripts/build-server.sh && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Findy",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/finance-server"
    ],
    "resources": {
      "../node_modules/.prisma/client/libquery_engine-darwin-arm64.dylib.node": "libquery_engine-darwin-arm64.dylib.node",
      "../node_modules/.prisma/client/libquery_engine-darwin.dylib.node": "libquery_engine-darwin.dylib.node"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/avialleguerin/Findy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1Nzc3NTgzQUI3RkRGMDMKUldRRDMzK3JnM1YzdGRDWit6ekQrNUExYVIwb2NnMVNPRkpjMjdhY1daM1pKMHI0WnVSQm40ajkK"
    }
  }
}
